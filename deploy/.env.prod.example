# FirstSun Pharmacy — 云端演示环境变量
# 复制为 .env.prod 并填入真实值，禁止提交到 Git
# 用法：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── 数据库（必填，请修改默认值）──────────────────────────
MYSQL_ROOT_PASSWORD=<替换为强密码>
MYSQL_DATABASE=firstsun_pharmacy
MYSQL_USER=pharmacy
MYSQL_PASSWORD=<替换为强密码>

# ── 端口（仅绑定 127.0.0.1，通过 SSH 隧道访问）────────
BACKEND_PORT=48080
ADMIN_PORT=80

# ── JVM（低内存调优，一般无需修改）─────────────────────
JAVA_OPTS=-Xms128m -Xmx256m -Djava.security.egd=file:/dev/./urandom

# ── AI 密钥（可选）───────────────────────────────────
PHARMACY_AI_API_KEY=

# ── 药店微信登录（真实联调必填；禁止提交实际值）────────
# 可信会员归属租户；后端拒绝客户端提交的租户编号
PHARMACY_WECHAT_TENANT_ID=
# 必须与微信开发者工具项目 AppID 一致
PHARMACY_WECHAT_APP_ID=
# WxJava 小程序 SDK 的实际配置前缀为 wx.miniapp
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ── 演示测试验证码（仅 local/dev profile 生效）────────
# SSH 隧道访问限制下使用；留空则禁用快捷登录
PHARMACY_DEV_SMS_CODE=
