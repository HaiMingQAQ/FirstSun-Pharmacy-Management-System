# ==================================================
# 开发环境（H5 本地联调）环境变量
# 由 vite 通过 envPrefix "SHOPRO_" 注入 import.meta.env
# ==================================================

# 后端接口基础地址（本地 yudao-server，默认 48080 端口）
SHOPRO_DEV_BASE_URL=http://localhost:48080

# 接口前缀
SHOPRO_API_PATH=/app-api

# 多租户编号（药店演示数据在租户 163，见 sql/migrations/20260914_l_pharmacy_demo_data.sql）
SHOPRO_TENANT_ID=163

# H5 开发服务器监听端口
SHOPRO_DEV_PORT=5173

# 静态资源地址（本地与接口同源）
SHOPRO_STATIC_URL=http://localhost:48080

# WebSocket 路径
SHOPRO_WEBSOCKET_PATH=/infra/ws

# H5 站点访问地址
SHOPRO_H5_URL=http://localhost:5173

# 上传方式：server = 后端中转上传，client = 前端直连上传
SHOPRO_UPLOAD_TYPE=server

# 微信小程序直播插件开关（仅 mp-weixin 平台生效）
SHOPRO_MPLIVE_ON=0
