# 复制本文件为 .env 并填写（.env 已被 .gitignore 忽略，不会提交到 GitHub）
# 建议团队统一一套值，保证所有人连的库名/账号一致
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=firstsun_pharmacy
MYSQL_USER=pharmacy
MYSQL_PASSWORD=pharmacy123
# 宿主机端口：默认 3307，避开本机原生 MySQL 占用的 3306；应用统一连 localhost:3307
MYSQL_PORT=3307

# Redis 缓存端口
REDIS_PORT=6379
# 后端端口
BACKEND_PORT=48080
# 管理端端口
ADMIN_PORT=80
# 管理端浏览器访问后端地址
VITE_BASE_URL=http://localhost:48080
# 后端 JVM 参数
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

# AI 大模型密钥：仅填写到本地 .env，禁止提交真实值
PHARMACY_AI_API_KEY=

# 会员手机号快捷登录的「开发测试验证码」（F 模块）
# - 只在本机 .env 里填写具体值，禁止把真实值写进代码、前端、SQL 或 Dockerfile，也不要提交到 Git
# - 仅 local/dev profile 生效；prod 环境会整体禁用手机号快捷登录，不会接受该验证码
# - 填写任意 4-8 位数字/字母即可，例如 6 位数字；团队各人可不同
PHARMACY_DEV_SMS_CODE=
